# Banco de dados
DB_NAME=wachafit
DB_USER=wachafit
DB_PASSWORD=troque-aqui

# JWT (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-chars
JWT_EXPIRATION=3600

# Email SMTP
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=SG.xxxxxx

# App
APP_FRONTEND_URL=https://app.wachafit.com
PORT=80

# Pagamento (opcional; default=manual)
# Para usar Mercado Pago: PAYMENT_GATEWAY=mercadopago
# PAYMENT_ACCESS_TOKEN = Access Token (teste ou produção) do painel Mercado Pago Developers
# PAYMENT_WEBHOOK_SECRET = "Assinatura secreta" configurada na notificação webhook do MP
# PAYMENT_NOTIFICATION_URL = URL pública do backend + /api/payments/webhook (o MP precisa alcançá-la pela internet)
PAYMENT_GATEWAY=manual
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_NOTIFICATION_URL=
PAYMENT_SUSPEND_AFTER_DAYS=5
